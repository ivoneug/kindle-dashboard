{
  "name": "kindle-dashd",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kindle K3 dashboard for Codex and Claude Code: sessions, usage, approvals and e-ink frames",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/index.js",
    "fonts": "node scripts/extract-fonts.js",
    "test": "node scripts/run-tests.js",
    "install-hooks": "node scripts/manage-hooks.js",
    "uninstall-hooks": "node scripts/manage-hooks.js --remove",
    "mock": "DASHD_AGENT=claude CLAUDE_THING_MOCK=1 node src/index.js",
    "install-hooks:codex": "node scripts/install-codex-hooks.js",
    "uninstall-hooks:codex": "node scripts/install-codex-hooks.js --remove",
    "start:claude": "DASHD_AGENT=claude node src/index.js",
    "install-hooks:claude": "node scripts/install-hooks.js",
    "uninstall-hooks:claude": "node scripts/uninstall-hooks.js"
  },
  "dependencies": {
    "marked": "^18.1.2",
    "playwright-core": "^1.64.1",
    "pngjs": "^7.0.0"
  }
}
